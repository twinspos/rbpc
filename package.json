{
  "name": "rb-pos-pc",
  "productName": "RB POS",
  "version": "1.0.0",
  "description": "RB POS untuk PC (Windows)",
  "main": "main.js",
  "author": "RB Ban",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "id.rbban.pos.pc",
    "productName": "RB POS",
    "files": ["main.js", "preload.js", "icon.ico", "www/**/*"],
    "extraResources": [{ "from": "rawprint.exe", "to": "rawprint.exe" }],
    "win": { "target": ["nsis", "portable"], "icon": "icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RB POS",
      "artifactName": "RB-POS-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "RB-POS-Portable-${version}.${ext}" }
  }
}
